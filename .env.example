# Identité affichée dans les métadonnées du site
SITE_TITLE=Association POC
SITE_DESCRIPTION=Proof of concept du site de l’association

# Paramètres du cookie de session côté serveur
SESSION_COOKIE_NAME=association_poc_session
SESSION_COOKIE_MAX_AGE=86400
# Optionnel : utile uniquement si le cookie doit être partagé entre sous-domaines
# SESSION_COOKIE_DOMAIN=.example.org

# MongoDB Atlas (cluster0)
# Ne jamais committer les valeurs réelles. Choisir la base selon l’environnement :
#   gui-website-dev      — développement local
#   gui-website-recette  — recette / staging
#   gui-website-prod     — production
# MONGODB_URI=mongodb+srv://<app_user>:<password>@cluster0.<id>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=gui-website-dev
# DATA_SOURCE=mock

# Secrets futurs : ne jamais utiliser le préfixe NEXT_PUBLIC_.
# AUTH_SECRET=
# CONTACT_PROVIDER_API_KEY=
